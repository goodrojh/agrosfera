# Порт HTTP API
PORT=8080
# Путь к базе SQLite
DB_PATH=./data/agrosfera.db
# Адрес сайта (для CORS). Для GitHub Pages: https://goodrojh.github.io
CORS_ORIGIN=https://goodrojh.github.io

# Telegram: токен от @BotFather и имя бота без @
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Чат (id), куда приходят заявки с сайта и цены на модерацию
ADMIN_CHAT_ID=

# MAX: токен бота из кабинета платформы MAX для партнёров и имя бота
MAX_BOT_TOKEN=
MAX_BOT_USERNAME=

# Во сколько (по Москве) напоминать предприятиям, не приславшим цену
REMINDER_HOUR=9
